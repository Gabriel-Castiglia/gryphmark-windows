<Window x:Class="Gryphmark.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Gryphmark" Width="1200" Height="820" MinWidth="560" MinHeight="380"
        Icon="pack://application:,,,/Gryphmark.ico"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        AllowDrop="True" Background="{DynamicResource Gm.Chrome}">
    <DockPanel>
        <Menu x:Name="MainMenu" DockPanel.Dock="Top" />
        <Border x:Name="ToolBarHost" DockPanel.Dock="Top" Style="{DynamicResource Gm.ToolBar}">
            <DockPanel LastChildFill="False">
                <Border DockPanel.Dock="Right" Style="{DynamicResource Gm.SegmentHost}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="SegVisual" Style="{DynamicResource Gm.Segment}" GroupName="mode" />
                        <RadioButton x:Name="SegSource" Style="{DynamicResource Gm.Segment}" GroupName="mode" />
                        <RadioButton x:Name="SegPreview" Style="{DynamicResource Gm.Segment}" GroupName="mode" />
                    </StackPanel>
                </Border>
                <StackPanel x:Name="Tools" DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <StatusBar x:Name="Status" DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusPath" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StatusWords" Margin="0,0,18,0" />
                    <TextBlock x:Name="StatusMode" Margin="0,0,18,0" />
                    <TextBlock x:Name="StatusState" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OutlineColumn" Width="0" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- Outline -->
            <Border x:Name="OutlinePane" Grid.Column="0" Background="{DynamicResource Gm.Chrome}" BorderBrush="{DynamicResource Gm.ChromeBorder}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock x:Name="OutlineTitle" DockPanel.Dock="Top" Margin="18,14,12,8" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Gm.TextMuted}" FontFamily="{DynamicResource Gm.Font}" />
                    <TextBlock x:Name="OutlineEmpty" DockPanel.Dock="Top" Margin="18,4,12,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource Gm.TextMuted}" FontFamily="{DynamicResource Gm.Font}" />
                    <ListBox x:Name="OutlineList" Style="{DynamicResource Gm.OutlineList}" />
                </DockPanel>
            </Border>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- Find / replace -->
                <Border x:Name="FindBar" Grid.Row="0" Visibility="Collapsed" Background="{DynamicResource Gm.Chrome}"
                        BorderBrush="{DynamicResource Gm.ChromeBorder}" BorderThickness="0,0,0,1" Padding="12,7">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="FindCount" MinWidth="70" TextAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center"
                                           FontSize="12" Foreground="{DynamicResource Gm.TextMuted}" FontFamily="{DynamicResource Gm.Font}" />
                                <ToggleButton x:Name="FindCase" Style="{DynamicResource Gm.ToolToggle}" Content="Aa" />
                                <Button x:Name="FindPrev" Style="{DynamicResource Gm.ToolButton}" Content="&#xE70E;" />
                                <Button x:Name="FindNextBtn" Style="{DynamicResource Gm.ToolButton}" Content="&#xE70D;" />
                                <Button x:Name="FindCloseBtn" Style="{DynamicResource Gm.ToolButton}" Content="&#xE711;" FontSize="12" />
                            </StackPanel>
                            <TextBox x:Name="FindBox" Style="{DynamicResource Gm.Field}" MaxWidth="520" HorizontalAlignment="Left" Width="420" />
                        </DockPanel>
                        <DockPanel x:Name="ReplaceRow" Margin="0,6,0,0" Visibility="Collapsed">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" />
                            <TextBox x:Name="ReplaceBox" Style="{DynamicResource Gm.Field}" Width="420" HorizontalAlignment="Left" />
                            <Button x:Name="ReplaceBtn" Style="{DynamicResource Gm.DialogButton}" />
                            <Button x:Name="ReplaceAllBtn" Style="{DynamicResource Gm.DialogButton}" HorizontalAlignment="Left" />
                        </DockPanel>
                    </StackPanel>
                </Border>
                <wv2:WebView2 x:Name="Web" Grid.Row="1" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
