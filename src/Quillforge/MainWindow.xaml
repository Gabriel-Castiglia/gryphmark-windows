<Window x:Class="Quillforge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Quillforge" Width="1200" Height="820" MinWidth="560" MinHeight="380"
        Icon="pack://application:,,,/Quillforge.ico"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        AllowDrop="True" Background="{DynamicResource Qf.Chrome}">
    <DockPanel>
        <Menu x:Name="MainMenu" DockPanel.Dock="Top" />
        <Border x:Name="ToolBarHost" DockPanel.Dock="Top" Style="{DynamicResource Qf.ToolBar}">
            <DockPanel LastChildFill="False">
                <Border DockPanel.Dock="Right" Style="{DynamicResource Qf.SegmentHost}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="SegVisual" Style="{DynamicResource Qf.Segment}" GroupName="mode" />
                        <RadioButton x:Name="SegSource" Style="{DynamicResource Qf.Segment}" GroupName="mode" />
                        <RadioButton x:Name="SegPreview" Style="{DynamicResource Qf.Segment}" GroupName="mode" />
                    </StackPanel>
                </Border>
                <StackPanel x:Name="Tools" DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <StatusBar x:Name="Status" DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusPath" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StatusWords" Margin="0,0,18,0" />
                    <TextBlock x:Name="StatusMode" Margin="0,0,18,0" />
                    <TextBlock x:Name="StatusState" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
        <wv2:WebView2 x:Name="Web" />
    </DockPanel>
</Window>
