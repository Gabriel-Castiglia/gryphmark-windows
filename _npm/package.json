{
  "name": "_npm",
  "version": "1.0.0",
  "description": "Web dependencies of Gryphmark, bundled by esbuild (see build.ps1)",
  "author": "Gabriel Castiglia",
  "license": "GPL-2.0-only",
  "type": "commonjs",
  "dependencies": {
    "@toast-ui/editor": "^3.2.2",
    "@toast-ui/editor-plugin-code-syntax-highlight": "^3.1.0",
    "diff": "^9.0.0",
    "dompurify": "3.4.17",
    "esbuild": "^0.25.5",
    "gemoji": "^8.1.0",
    "github-markdown-css": "^5.8.1",
    "highlight.js": "^11.11.1",
    "katex": "^0.19.1",
    "marked": "^15.0.12",
    "marked-alert": "^2.1.2",
    "marked-footnote": "^1.2.4",
    "marked-katex-extension": "^5.1.13",
    "mermaid": "^12.3.0"
  },
  "private": true,
  "overrides": {
    "@toast-ui/editor": {
      "dompurify": "$dompurify"
    },
    "marked-katex-extension": {
      "katex": "$katex"
    },
    "mermaid": {
      "katex": "$katex"
    }
  }
}
